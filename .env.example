# Copy to .env and fill in.  .env is gitignored — never commit real keys.
#   cp .env.example .env

# --- LLM provider (Groq only — everything is free, no paid provider) ---
GROQ_API_KEY=

# Model tiers for the 2x2 design (override here only if the ids change in your console):
#   cheap/small model  -> V1, V2
#   strong/large model -> V3, V4
GROQ_MODEL_CHEAP=llama-3.1-8b-instant
GROQ_MODEL_STRONG=llama-3.3-70b-versatile

# Optional, only if you ever choose to add paid credit / a second provider:
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- Results DB: Supabase Postgres ---
# Supabase dashboard > Project Settings > Database > Connection string (URI).
# Prefer the connection-pooler URI (port 6543) for scripts; direct (5432) also works.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# --- Reproducibility (spec §6.2: fixed seed, non-negotiable) ---
RANDOM_SEED=20260721

# --- Paths (local, gitignored) ---
DATA_DIR=./data
DATABASES_DIR=./databases
